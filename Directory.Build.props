<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Authors>bariskisir</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <Target Name="SetVersionFromGitTag" BeforeTargets="GetAssemblyVersion" Condition="'$(Version)' == '1.0.0'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v*&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
    </Exec>
    <PropertyGroup>
      <Version Condition="'$(GitTag)' != ''">$(GitTag.Trim().TrimStart('v'))</Version>
    </PropertyGroup>
    <Message Text="Version from git: $(Version)" Importance="High" />
  </Target>
</Project>
