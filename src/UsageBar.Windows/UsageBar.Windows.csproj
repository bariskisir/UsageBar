<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>UsageBar.Windows</RootNamespace>
    <AssemblyName>UsageBar</AssemblyName>
    <AssemblyTitle>Usage Bar</AssemblyTitle>
    <Product>Usage Bar</Product>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>

    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GarbageCollectionConcurrent>false</GarbageCollectionConcurrent>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageBar.Core\UsageBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UsageBar.Tests" />
  </ItemGroup>

  <!-- WebView2 pulls WPF/WinForms assemblies we don't use. -->
  <Target Name="RemoveUnusedWebView2Libs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WpfWinFormsRefs Include="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(_WpfWinFormsRefs)" />
    </ItemGroup>
  </Target>

</Project>
