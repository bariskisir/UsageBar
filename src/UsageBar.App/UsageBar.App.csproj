<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>UsageBar</RootNamespace>
    <AssemblyName>UsageBar</AssemblyName>
    <!-- Friendly display name (FileDescription) shown above tray notifications;
         keep AssemblyName as UsageBar so the artifact stays UsageBar.exe. -->
    <AssemblyTitle>Usage Bar</AssemblyTitle>
    <Product>Usage Bar</Product>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- P/Invoke declarations are intentionally hand-written DllImports;
         silence the LibraryImport source-generator suggestion. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>

    <!-- Runtime/publish slimming. InvariantGlobalization drops ICU (the app formats with
         InvariantCulture everywhere); symbols are embedded so no loose .pdb ships; and referenced
         packages' companion .xml/.pdb (e.g. the ~600 KB WebView2 doc file) are no longer copied. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!-- Memory tuning for a low-activity resident tray app: Workstation (not Server) GC avoids
         per-core heap reservations, and disabling background GC drops the dedicated GC thread.
         ConserveMemory (0-9) makes the GC compact and release segments to the OS more eagerly;
         5 is a moderate balance (refresh only runs ~every 5 min, so no need for the aggressive 9). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GarbageCollectionConcurrent>false</GarbageCollectionConcurrent>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageBar.Core\UsageBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\index.html" />
    <EmbeddedResource Include="Assets\openai.svg" />
    <EmbeddedResource Include="Assets\claude.svg" />
    <EmbeddedResource Include="Assets\elevenlabs.svg" />
    <EmbeddedResource Include="Assets\kilo.svg" />
    <EmbeddedResource Include="Assets\copilot.svg" />
    <EmbeddedResource Include="Assets\warp.svg" />
    <EmbeddedResource Include="Assets\synthetic.svg" />
    <EmbeddedResource Include="Assets\chutes.svg" />
    <EmbeddedResource Include="Assets\zai.svg" />
    <EmbeddedResource Include="Assets\alibaba.svg" />
    <EmbeddedResource Include="Assets\minimax.svg" />
    <EmbeddedResource Include="Assets\codebuff.svg" />
    <EmbeddedResource Include="Assets\antigravity.svg" />
  </ItemGroup>

  <!-- WebView2 pulls WPF/WinForms assemblies we don't use; their WPF dependency
       on WindowsBase 5.0 conflicts with .NET's built-in WindowsBase 4.0.
       Remove them BEFORE assembly resolution so MSB3277 is never raised. -->
  <Target Name="RemoveUnusedWebView2Libs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WpfWinFormsRefs Include="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(_WpfWinFormsRefs)" />
    </ItemGroup>
  </Target>

</Project>
