<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>UsageBar</RootNamespace>
    <AssemblyName>UsageBar</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- P/Invoke declarations are intentionally hand-written DllImports;
         silence the LibraryImport source-generator suggestion. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageBar.Core\UsageBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\usagebar.css" />
    <EmbeddedResource Include="Assets\tooltip.js" />
  </ItemGroup>

  <!-- WebView2 pulls WPF/WinForms assemblies we don't use; their WPF dependency
       on WindowsBase 5.0 conflicts with .NET's built-in WindowsBase 4.0.
       Remove them BEFORE assembly resolution so MSB3277 is never raised. -->
  <Target Name="RemoveUnusedWebView2Libs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WpfWinFormsRefs Include="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(_WpfWinFormsRefs)" />
    </ItemGroup>
  </Target>

</Project>
